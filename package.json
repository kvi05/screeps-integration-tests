{
    "name": "screeps-integration-tests",
    "version": "1.0.0",
    "description": "Портативный интеграционный тестовый фреймворк для Screeps ботов на базе screeps-server-mockup.",
    "main": "src/lib/world.js",
    "type": "commonjs",
    "scripts": {
        "test:integration": "node src/run-all.js",
        "test:integration:profiling": "node src/run-all.js --profiling",
        "test:integration:smoke": "node src/run-all.js --only smoke-empty",
        "test:integration:unit": "jest --config jest.config.js",
        "test:integration:clean": "node src/tools/clean-cache.js",
        "test:integration:capture": "node src/tools/capture-fixture.js",
        "test": "jest --config jest.config.js"
    },
    "keywords": [
        "screeps",
        "screeps-bot",
        "integration-tests",
        "screeps-server-mockup",
        "javascript"
    ],
    "author": "kvi05",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/kvi05/screeps-integration-tests.git"
    },
    "bugs": {
        "url": "https://github.com/kvi05/screeps-integration-tests/issues"
    },
    "homepage": "https://github.com/kvi05/screeps-integration-tests#readme",
    "engines": {
        "node": ">=22.12.0"
    },
    "dependencies": {
        "screeps-server-mockup": "screepers/screeps-server-mockup#master",
        "tree-kill": "^1.2.2"
    },
    "devDependencies": {
        "jest": "^30.4.2"
    }
}
