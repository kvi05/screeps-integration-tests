{
    "name": "screeps-integration-tests",
    "version": "3.0.0",
    "description": "Portable integration test framework for Screeps bots. Run your bot against a full local game server — verify behavior, collect metrics, no game subscription needed.",
    "main": "src/index.js",
    "type": "commonjs",
    "bin": {
        "screeps-integration-tests": "bin/screeps-integration-tests.js",
        "sit": "bin/screeps-integration-tests.js"
    },
    "exports": {
        ".": "./src/index.js",
        "./assertions": "./src/public/assertions.js",
        "./metrics": "./src/public/metrics.js",
        "./metric-assertions": "./src/public/metric-assertions.js",
        "./memory-fixtures": "./src/public/memory-fixtures.js",
        "./room-fixtures": "./src/public/room-fixtures.js",
        "./world-helpers": "./src/public/worldHelpers.js",
        "./events": "./src/public/events.js",
        "./errors": "./src/public/errors.js",
        "./constants": "./src/public/constants.js",
        "./snapshot": "./src/public/snapshot.js",
        "./package.json": "./package.json"
    },
    "files": [
        "bin",
        "src",
        "examples",
        "!**/.cache",
        "!**/node_modules",
        "!**/dist"
    ],
    "scripts": {
        "help": "node src/tools/help.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "jest --config jest.config.js",
        "check": "npm run lint && npm run format:check && npm run viewer:build && npm test && npm run test:integration && npm run viewer:test",
        "test:integration": "node bin/screeps-integration-tests.js --config examples/screeps-integration.config.js",
        "test:integration:smoke": "npm run test:integration -- --only smoke-empty",
        "test:integration:profiling": "npm run test:integration -- --profiling",
        "viewer": "npm run test:integration -- --viewer",
        "viewer:build": "npm --prefix src/tools/viewer/client install --no-audit --no-fund && npm --prefix src/tools/viewer/client run build",
        "viewer:test": "npm --prefix src/tools/viewer/client test",
        "viewer:dev": "npm --prefix src/tools/viewer/client run dev",
        "fixture:capture": "node src/tools/capture-fixture.js",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{yml,yaml,md,markdown,json}": [
            "prettier --write"
        ]
    },
    "keywords": [
        "screeps",
        "screeps-bot",
        "integration-tests",
        "screeps-server-mockup",
        "javascript"
    ],
    "author": "kvi05",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kvi05/screeps-integration-tests.git"
    },
    "bugs": {
        "url": "https://github.com/kvi05/screeps-integration-tests/issues"
    },
    "homepage": "https://github.com/kvi05/screeps-integration-tests#readme",
    "engines": {
        "node": ">=22.12.0"
    },
    "dependencies": {
        "@cool-andre/screeps-server-mockup": "^1.5.2",
        "tree-kill": "^1.2.2"
    },
    "devDependencies": {
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "lint-staged": "^17.2.0",
        "prettier": "^3.9.5"
    }
}
